# ─── QVAC ────────────────────────────────────────────────────────────────────
# Wally talks to the OpenAI-compatible server started with:
#   qvac serve openai -c qvac.config.json
# Point qvac.config.json's model src at a .gguf under ~/.qvac/models/ (Qwen3 4B or larger).
# QVAC_SERVER_URL can point at any machine the operator controls — localhost or a server.
QVAC_SERVER_URL=http://127.0.0.1:11434
QVAC_MODEL=wally-llm
# Only needed for a non-loopback QVAC server (which also requires https):
# QVAC_API_KEY=

# ─── Network exposure ────────────────────────────────────────────────────────
# Wally binds to loopback only. Exposing the wallet interface to a network is
# an explicit opt-in and should never be done on an untrusted network.
# HOST=127.0.0.1
# WALLY_ALLOW_REMOTE=false
# Required when WALLY_ALLOW_REMOTE=true: a shared secret (>=16 chars) that
# clients must present (?access_token=... or x-wally-access header) before a
# session cookie is issued. Not needed on the loopback default.
# WALLY_ACCESS_TOKEN=

# ─── WDK Seed (choose one source; WDK_SEED_COMMAND is recommended in production) ─
# WDK_SEED_COMMAND — shell command whose stdout is the 12/24-word BIP-39 seed.
# Example: WDK_SEED_COMMAND=op read op://Personal/WallyWallet/seed
WDK_SEED_COMMAND=

# WDK_SEED_FILE — path to a file containing only the seed phrase.
WDK_SEED_FILE=

# WDK_SEED — the seed phrase directly (development only; never use in production).
WDK_SEED=

# ─── WDK Chains ───────────────────────────────────────────────────────────────
# Comma-separated list of chains to enable in the WDK MCP subprocess.
# Supported by installed packages: ethereum, arbitrum, bitcoin
WDK_CHAINS=ethereum,arbitrum,bitcoin

# ─── WDK RPC Endpoints ────────────────────────────────────────────────────────
# Override default public RPC endpoints. Optional but recommended for production.
WDK_RPC_ETHEREUM=https://rpc.mevblocker.io/fast
WDK_RPC_ARBITRUM=https://arb1.arbitrum.io/rpc

# ─── WDK Indexer ──────────────────────────────────────────────────────────────
# Enables on-chain transaction history queries ("how much did I send last week").
# Get a key from https://wdk.tether.io
WDK_INDEXER_API_KEY=

# ─── Network ──────────────────────────────────────────────────────────────────
# testnet | mainnet
NETWORK_MODE=testnet

# ─── Gasless (ERC-4337 smart account) — the intended Wally experience ─────────
# Pay fees in USDT instead of ETH. Ten minute setup, one free API key: GASLESS.md.
# Copy wdk.config.example.json to wdk.config.json, paste your Pimlico key into the
# two URLs, then uncomment both lines below and restart.
# WDK_CONFIG=./wdk.config.json
# WALLY_GASLESS_CHAINS=arbitrum

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=change-me-in-production
