EXPO_PUBLIC_QVAC_URL=http://127.0.0.1:11434
EXPO_PUBLIC_QVAC_MODEL=wally-llm
EXPO_PUBLIC_WALLY_API_URL=http://127.0.0.1:3003

# ─── Wally backend proxy (optional) ──────────────────────────────────────────
# Routes market data through ../backend instead of calling CoinGecko directly, so the
# provider key stays on the server and every phone shares one cached, rate-limited origin.
# Leave unset and the app calls CoinGecko directly, exactly as before.
# EXPO_PUBLIC_WALLY_PROXY_URL=http://127.0.0.1:8080

# Shared key the backend may require (see backend/.env.example). Compiled into the
# bundle, so it deters casual abuse rather than being a real secret.
# EXPO_PUBLIC_WALLY_APP_KEY=
