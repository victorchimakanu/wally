{
  "name": "wally-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@qvac/fabric-android-arm64": "0.18.1",
    "@qvac/sdk": "0.21.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "bare-pack": "2.0.1",
    "expo": "~57.0.30",
    "expo-battery": "~57.0.3",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-dev-client": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.13",
    "expo-router": "~57.0.28",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-bare-kit": "0.15.5",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start:local": "node --dns-result-order=ipv4first node_modules/expo/bin/cli start --go --localhost --port 8082 --max-workers 2",
    "wallet:install": "npm install --prefix ../internal/wallet-api-runtime --save-exact @tetherto/wdk-wallet-evm@1.0.0-beta.14 qrcode@1.5.4 --no-audit --no-fund",
    "wallet:server": "node scripts/wallet-api-server.mjs",
    "test:wallet": "node --test test/wallet-server.test.mjs",
    "start": "expo start --go",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "export:web": "expo export --platform web --output-dir dist/web",
    "export:android": "expo export --platform android --output-dir dist/android",
    "ai:server": "node scripts/qvac-server.mjs",
    "ai:server:vulkan": "node scripts/qvac-server.mjs --vulkan",
    "ai:benchmark": "node --experimental-strip-types scripts/benchmark-qvac.mjs",
    "android:local-ai": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-android.ps1",
    "android:preview": "expo start --go --android",
    "phone:check": "node scripts/phone-tools.mjs check",
    "phone:prebuild": "node scripts/phone-tools.mjs prebuild",
    "phone:build": "node scripts/phone-tools.mjs build",
    "phone:export": "node scripts/phone-tools.mjs export",
    "phone:start": "node scripts/phone-tools.mjs start"
  },
  "private": true,
  "type": "module"
}
