{
  "loggerLevel": "info",
  "rpcInitTimeoutMs": 120000,
  "httpConnectionTimeoutMs": 30000,
  "serve": {
    "models": {
      "wally-llm": {
        "default": true,
        "preload": true,
        "config": {
          "device": "cpu",
          "gpu_layers": 0,
          "ctx_size": 2048,
          "load_mode": "mmap"
        },
