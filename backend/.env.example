# Wally backend configuration.
# Copy to .env.local and edit. This service holds no keys, seeds or personal data.

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
# Loopback by default. On a VPS, keep it loopback and put nginx or Caddy in front
# to terminate TLS. Set 0.0.0.0 only if something else handles TLS and firewalling.
HOST=127.0.0.1
LOG_LEVEL=info

# Browser origins allowed to call this service, comma separated. The native app sends
# no Origin header and is unaffected. Only needed for the Expo web preview.
# ALLOWED_ORIGINS=http://127.0.0.1:8082,http://localhost:8082

# ─── Chain providers ─────────────────────────────────────────────────────────
# Public endpoints by default. Replace with a paid provider before real traffic;
# the whole point of this proxy is that the key lives here, not in the app.
RPC_ARBITRUM=https://sepolia-rollup.arbitrum.io/rpc
RPC_ETHEREUM=https://ethereum-sepolia-rpc.publicnode.com

# Transaction indexer. Defaults to etherscan because Blockscout returns a Cloudflare 403
# for Arbitrum Sepolia to this server as well as to the phone (measured 20 Oct 2026).
# One free Etherscan key covers BOTH chains via the v2 chainid parameter.
#   get one at https://etherscan.io/apis
INDEXER_PROVIDER=etherscan
ETHERSCAN_BASE=https://api.etherscan.io/v2/api
# ETHERSCAN_API_KEY=

# Only used when INDEXER_PROVIDER=blockscout
INDEXER_ARBITRUM=https://arbitrum-sepolia.blockscout.com
INDEXER_ETHEREUM=https://eth-sepolia.blockscout.com

# Allow the proxy to relay already-signed transactions (eth_sendRawTransaction).
# It cannot alter one — changing any byte invalidates the signature — so the risk is
# abuse as an open broadcast relay, which rate limiting bounds. Off by default.
RPC_ALLOW_BROADCAST=false

# ─── Market data ─────────────────────────────────────────────────────────────
COINGECKO_BASE=https://api.coingecko.com/api/v3
# Optional. A demo key raises the rate limit. Keep it here, never in the app.
# COINGECKO_API_KEY=

# ─── Access ──────────────────────────────────────────────────────────────────
# Shared key callers must send as `x-wally-key`. Optional on loopback; REQUIRED when HOST
# is not loopback (the server refuses to start without it). The app ships this in its
# bundle, so it deters casual abuse rather than being a true secret.
#   generate with:  openssl rand -base64 32
# WALLY_APP_KEY=

# ─── Limits and caching ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=120
# Which proxy may set X-Forwarded-For. Defaults to the loopback address, matching a reverse
# proxy on the same host. Do NOT set this to `true`: that honours the header from any client
# and lets anyone who can reach this port directly forge their IP past the rate limiter.
# An address or CIDR only. A hop count is refused at startup: it is spoofable, per
# GHSA-3m5p-2c4r-xxw2.
TRUSTED_PROXY=127.0.0.1
UPSTREAM_TIMEOUT_MS=12000
MARKET_CACHE_MS=60000
CHART_CACHE_MS=300000
HISTORY_CACHE_MS=15000
# Cache for safe RPC reads (balances). The app polls every 60s per chain per user, so this
# collapses a crowd into one upstream call. Nonce, gas and receipts are never cached. 0 disables.
RPC_CACHE_MS=10000

# ─── Local model server (QVAC) ───────────────────────────────────────────────
# The backend fronts QVAC because QVAC omits the CORS header on streaming responses,
# which makes browsers block every streamed chat reply. Point the app's
# EXPO_PUBLIC_QVAC_URL at this backend rather than directly at 11434.
QVAC_URL=http://127.0.0.1:11434
# Inference is slow on CPU (measured 8-16s here), so it gets its own budget.
QVAC_TIMEOUT_MS=120000
